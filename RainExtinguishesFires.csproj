<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>RainExtinguishesFires</AssemblyName>
    <RootNamespace>RainExtinguishesFires</RootNamespace>
    <Version>1.2.0</Version>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
    <InformationalVersion>1.2.0</InformationalVersion>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GameDir Condition="'$(GameDir)' == ''">$(SOTF_GAME_DIR)</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RedLoader">
      <HintPath>$(GameDir)\Modstoke\Runtime\Compatibility\RedLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SonsSdk">
      <HintPath>$(GameDir)\Modstoke\Runtime\Compatibility\SonsSdk.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="FMOD.Unity">
      <HintPath>$(GameDir)\BepInEx\interop\FMOD.Unity.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDir)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(GameDir)\BepInEx\core\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDir)\BepInEx\interop\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(GameDir)\BepInEx\interop\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(GameDir)\BepInEx\interop\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(GameDir)\BepInEx\interop\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sons.Atmosphere">
      <HintPath>$(GameDir)\BepInEx\interop\Sons.Atmosphere.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sons.Interfaces">
      <HintPath>$(GameDir)\BepInEx\interop\Sons.Interfaces.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sons.Construction">
      <HintPath>$(GameDir)\BepInEx\interop\Sons.Construction.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sons">
      <HintPath>$(GameDir)\BepInEx\interop\Sons.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="bolt">
      <HintPath>$(GameDir)\BepInEx\interop\bolt.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(GameDir)\BepInEx\interop\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>RainExtinguishesFires\manifest.json</TargetPath>
    </None>
    <None Update="extinguish.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>RainExtinguishesFires\extinguish.wav</TargetPath>
    </None>
  </ItemGroup>

  <Target Name="ValidateGameDir" BeforeTargets="ResolveReferences">
    <Error Condition="'$(GameDir)' == ''" Text="Set SOTF_GAME_DIR or pass -p:GameDir to the Sons of the Forest install directory." />
    <Error Condition="!Exists('$(GameDir)\BepInEx\interop\Sons.dll')" Text="GameDir must point to a Sons of the Forest install containing BepInEx/interop/Sons.dll." />
  </Target>
</Project>
